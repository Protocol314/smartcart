# systemd --user용 EnvironmentFile 예시. 비밀번호·키·토큰을 넣지 않는다.
# 실제 파일은 ~/.config/smartcart-sensing/sensing.env에 두고 권한을 600으로 제한한다.
SENSING_ROS_DISTRO=humble
# SENSING_ROS_WORKSPACE는 생략하면 현재 사용자의 ~/smartcart_ws이다.
# SENSING_SERIAL_PORT는 실제 ESP32 링크로 반드시 바꾼다. LiDAR 링크를 넣지 않는다.
SENSING_SERIAL_PORT=/dev/serial/by-id/ESP32_DEVICE_LINK_REPLACE_ME
SENSING_HTTP_PORT=8765
SENSING_SCAN_TOPIC=/scan
SENSING_UWB_TOPIC=/smartcart/uwb
ROS_LOCALHOST_ONLY=1
# ROS_DOMAIN_ID와 RMW_IMPLEMENTATION은 기존 LiDAR 설정과 같을 때만 명시한다.
# SENSING_UWB_YAW, SENSING_UWB_X, SENSING_UWB_Y는 미측정 초기값 0이다.
